<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/callRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Primary video fills the screen (remote by default) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/primaryRenderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Local preview in a rounded card (PIP) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pipCard"
        android:layout_width="120dp"
        android:layout_height="200dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:clipToOutline="true"
        app:cardCornerRadius="16dp"
        app:cardUseCompatPadding="true"
        app:strokeWidth="0dp"
        app:cardElevation="0dp">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/pipRenderer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Status overlay (top-left) -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:text="Connecting…"
        android:textSize="14sp"
        android:background="#66000000"
        android:textColor="@android:color/white"
        android:padding="6dp" />

    <!-- Bottom control bar (unchanged) -->
    <!-- Bottom control bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/callControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="30dp"
        android:clipToPadding="false">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnToggleMic"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_call_control_ripple"
        android:padding="8dp"
        android:contentDescription="Toggle microphone"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_mic"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnToggleCamera"
        app:layout_constraintHorizontal_chainStyle="spread_inside" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnToggleCamera"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_call_control_ripple"
        android:padding="8dp"
        android:contentDescription="Toggle camera"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_video_cam"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnToggleMic"
        app:layout_constraintEnd_toStartOf="@id/btnFlipCamera" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnFlipCamera"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_call_control_ripple"
        android:padding="8dp"
        android:contentDescription="Flip camera"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_flip_camera_android"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnToggleCamera"
        app:layout_constraintEnd_toStartOf="@id/btnEnd" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnEnd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_call_control_ripple"
        android:padding="8dp"
        android:contentDescription="End call"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_call_end"
        app:tint="@android:color/holo_red_light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnFlipCamera" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>