<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/callRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Primary video fills the screen (remote by default) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/primaryRenderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top overlay: full width, fixed opaque black, safe-area padding applied in code -->
    <LinearLayout
        android:id="@+id/topOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#B3000000"
    android:layout_gravity="top">

    <TextView
        android:id="@+id/remoteNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Peer"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="16sp" />

    <Chronometer
        android:id="@+id/callTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <!-- Colored status dot -->
    <View
        android:id="@+id/qualityDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/quality_dot"
        android:importantForAccessibility="no" />
</LinearLayout>

    <!-- Local preview in a rounded card (PIP) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pipCard"
        android:layout_width="120dp"
        android:layout_height="200dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="84dp"
    android:clipToOutline="true"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true"
    app:strokeWidth="0dp"
    app:cardElevation="0dp">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/pipRenderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</com.google.android.material.card.MaterialCardView>

    <!-- Bottom control bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/callControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="30dp"
        android:clipToPadding="false">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnToggleMic"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_call_control_ripple"
        android:padding="8dp"
        android:contentDescription="Toggle microphone"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_mic"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnToggleCamera"
        app:layout_constraintHorizontal_chainStyle="spread_inside" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnToggleCamera"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_call_control_ripple"
        android:padding="8dp"
        android:contentDescription="Toggle camera"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_video_cam"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnToggleMic"
        app:layout_constraintEnd_toStartOf="@id/btnFlipCamera" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnFlipCamera"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_call_control_ripple"
        android:padding="8dp"
        android:contentDescription="Flip camera"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_flip_camera_android"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnToggleCamera"
        app:layout_constraintEnd_toStartOf="@id/btnEnd" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnEnd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_call_control_ripple"
        android:padding="8dp"
        android:contentDescription="End call"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_call_end"
        app:tint="@android:color/holo_red_light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnFlipCamera" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>