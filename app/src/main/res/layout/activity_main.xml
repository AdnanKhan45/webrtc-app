<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Status line -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Ready for preview setup…" />

    <!-- Local video preview fills available space -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

    <!-- Bottom control bar (icon-only, transparent bg, perfectly even spacing) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/callControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnToggleMic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle microphone"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_mic"
            app:tint="@android:color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnToggleCamera"
            app:layout_constraintHorizontal_chainStyle="spread_inside" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnToggleCamera"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle camera"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_video_cam"
            app:tint="@android:color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnToggleMic"
            app:layout_constraintEnd_toStartOf="@id/btnFlipCamera" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnFlipCamera"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Flip camera"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_flip_camera_android"
            app:tint="@android:color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnToggleCamera"
            app:layout_constraintEnd_toStartOf="@id/btnEnd" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnEnd"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="End call"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_call_end"
            app:tint="@android:color/holo_red_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnFlipCamera" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>